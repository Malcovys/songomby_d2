generator client {
  provider     = "prisma-client"
  output       = "../packages/core/src/platform/prisma/generated"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ---------- Enums ----------

enum EmployeeStatus {
  ACTIVE
  ON_LEAVE
  TERMINATED
}

enum ContractType {
  CDI
  CDD
  INTERN
  FREELANCE
}

enum LeaveType {
  ANNUAL      // congé payé
  SICK        // arrêt maladie
  UNPAID      // sans solde
  MATERNITY
  PATERNITY
  OTHER
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum PayslipStatus {
  DRAFT
  GENERATED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  DONE
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
}

enum AuditStatus {
  PREVIEW     // aperçu proposé, pas encore appliqué
  APPLIED
  FAILED
  CANCELLED
}

// ---------- Modèles ----------

model Employee {
  id               String         @id @default(cuid())
  matricule        String         @unique
  firstName        String
  lastName         String
  email            String?        @unique
  phone            String?
  position         String
  department       String?
  contractType     ContractType   @default(CDI)
  status           EmployeeStatus @default(ACTIVE)
  hireDate         DateTime       @db.Date
  endDate          DateTime?      @db.Date
  baseSalary       Decimal        @db.Decimal(12, 2)
  leaveBalanceDays Decimal        @default(30) @db.Decimal(5, 1)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  leaves   LeaveRequest[]
  absences Absence[]
  payslips Payslip[]
  tickets  Ticket[]

  @@index([lastName, firstName])
  @@index([department])
}

// Congés ET arrêts maladie (type = SICK)
model LeaveRequest {
  id             String      @id @default(cuid())
  employeeId     String
  employee       Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type           LeaveType
  status         LeaveStatus @default(PENDING)
  startDate      DateTime    @db.Date
  endDate        DateTime    @db.Date
  days           Decimal     @db.Decimal(5, 1)
  reason         String?
  certificateRef String?
  certificateUrl String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([employeeId, startDate])
  @@index([status])
}

model Absence {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date       DateTime @db.Date
  justified  Boolean  @default(false)
  reason     String?
  createdAt  DateTime @default(now())

  @@index([employeeId, date])
}

model Holiday {
  id        String   @id @default(cuid())
  date      DateTime @unique @db.Date
  name      String
  createdAt DateTime @default(now())
}

model Payslip {
  id          String        @id @default(cuid())
  employeeId  String
  employee    Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  month       Int
  year        Int
  baseSalary  Decimal       @db.Decimal(12, 2)
  deductions  Decimal       @default(0) @db.Decimal(12, 2)
  bonuses     Decimal       @default(0) @db.Decimal(12, 2)
  netSalary   Decimal       @db.Decimal(12, 2)
  currency    String        @default("MGA")
  status      PayslipStatus @default(DRAFT)
  pdfUrl      String?
  generatedAt DateTime?
  createdAt   DateTime      @default(now())

  @@unique([employeeId, month, year])
}

model Ticket {
  id          String         @id @default(cuid())
  title       String
  description String?
  status      TicketStatus   @default(OPEN)
  priority    TicketPriority @default(MEDIUM)
  employeeId  String?
  employee    Employee?      @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([status])
}

// Trace de chaque action de l'agent
model AuditLog {
  id        String      @id @default(cuid())
  tool      String
  params    Json
  result    Json?
  status    AuditStatus @default(PREVIEW)
  error     String?
  createdAt DateTime    @default(now())

  @@index([tool, createdAt])
}
